const Database = require('better-sqlite3');
const path = require('path');
const fs = require('fs');

const DB_DIR = path.join(__dirname, '..', 'db');
const DB_PATH = path.join(DB_DIR, 'ma.db');

let db;

function getDB() {
  if (!db) {
    if (!fs.existsSync(DB_DIR)) fs.mkdirSync(DB_DIR, { recursive: true });
    db = new Database(DB_PATH);
    db.pragma('journal_mode = WAL');
    db.pragma('foreign_keys = ON');
  }
  return db;
}

// ── Schema ──
function initDB() {
  const d = getDB();

  d.exec(`
    -- Utilisateurs
    CREATE TABLE IF NOT EXISTS users (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      username TEXT UNIQUE NOT NULL COLLATE NOCASE,
      password_hash TEXT NOT NULL,
      display_name TEXT DEFAULT '',
      role TEXT NOT NULL DEFAULT 'joueur' CHECK(role IN ('mj','joueur')),
      created_at TEXT DEFAULT (datetime('now'))
    );

    -- Tables de jeu (campagnes)
    CREATE TABLE IF NOT EXISTS game_tables (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT NOT NULL,
      mj_id INTEGER NOT NULL REFERENCES users(id),
      created_at TEXT DEFAULT (datetime('now'))
    );

    -- Membres d'une table
    CREATE TABLE IF NOT EXISTS table_members (
      table_id INTEGER NOT NULL REFERENCES game_tables(id) ON DELETE CASCADE,
      user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
      PRIMARY KEY(table_id, user_id)
    );

    -- Systèmes stellaires (données globales, 1 ligne = 1 système)
    CREATE TABLE IF NOT EXISTS systems (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      quadrant TEXT NOT NULL,
      nom TEXT NOT NULL,
      faction TEXT DEFAULT '',
      is_frontiere INTEGER DEFAULT 0,
      route TEXT DEFAULT '',
      gouvernement TEXT DEFAULT '',
      description TEXT DEFAULT '',
      soleil_json TEXT DEFAULT '{}',
      corps_celestes_json TEXT DEFAULT '[]',
      patrouilles_json TEXT DEFAULT '[]',
      UNIQUE(quadrant, nom)
    );

    -- Factions (globales)
    CREATE TABLE IF NOT EXISTS factions (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT NOT NULL,
      color TEXT DEFAULT '#888888',
      short TEXT DEFAULT '',
      UNIQUE(name)
    );

    -- Modèles de vaisseaux (globaux, templates)
    CREATE TABLE IF NOT EXISTS ship_models (
      id TEXT PRIMARY KEY,
      nom TEXT NOT NULL,
      classe TEXT DEFAULT '',
      vitesse_croisiere REAL DEFAULT 0,
      vitesse_hyperspatiale REAL DEFAULT 0,
      autonomie REAL DEFAULT 0,
      manoeuvrabilite TEXT DEFAULT '',
      vitesse_tactique TEXT DEFAULT '',
      blindage INTEGER DEFAULT 0,
      coque INTEGER DEFAULT 0,
      senseurs TEXT DEFAULT '',
      equipage TEXT DEFAULT '',
      passagers TEXT DEFAULT '',
      soute REAL DEFAULT 0,
      prix REAL DEFAULT 0,
      origine TEXT DEFAULT '',
      image TEXT DEFAULT '',
      armement_json TEXT DEFAULT '[]',
      systemes_secondaires_json TEXT DEFAULT '[]'
    );

    -- Vaisseaux instanciés (par table de jeu)
    CREATE TABLE IF NOT EXISTS ships (
      id TEXT PRIMARY KEY,
      table_id INTEGER NOT NULL REFERENCES game_tables(id) ON DELETE CASCADE,
      nom TEXT NOT NULL,
      modele TEXT DEFAULT '',
      from_model TEXT DEFAULT '',
      position TEXT DEFAULT '',
      position_system TEXT DEFAULT '',
      position_astre TEXT DEFAULT '',
      classe TEXT DEFAULT '',
      origine TEXT DEFAULT '',
      vitesse_croisiere REAL DEFAULT 0,
      vitesse_hyperspatiale REAL DEFAULT 0,
      autonomie REAL DEFAULT 0,
      manoeuvrabilite TEXT DEFAULT '',
      vitesse_tactique TEXT DEFAULT '',
      blindage INTEGER DEFAULT 0,
      coque INTEGER DEFAULT 0,
      senseurs TEXT DEFAULT '',
      equipage TEXT DEFAULT '',
      passagers TEXT DEFAULT '',
      soute REAL DEFAULT 0,
      prix REAL DEFAULT 0,
      image TEXT DEFAULT '',
      armement_json TEXT DEFAULT '[]',
      systemes_secondaires_json TEXT DEFAULT '[]'
    );

    -- Données de base des périls (globales, 1 ligne par type)
    CREATE TABLE IF NOT EXISTS peril_data (
      type TEXT PRIMARY KEY,
      data_json TEXT NOT NULL
    );

    -- Tables de périls personnalisées (par table de jeu)
    CREATE TABLE IF NOT EXISTS custom_peril_tables (
      id TEXT PRIMARY KEY,
      table_id INTEGER NOT NULL REFERENCES game_tables(id) ON DELETE CASCADE,
      data_json TEXT NOT NULL
    );

    -- Assignations de tables de périls (par table de jeu)
    CREATE TABLE IF NOT EXISTS peril_assignments (
      table_id INTEGER NOT NULL REFERENCES game_tables(id) ON DELETE CASCADE,
      assign_type TEXT NOT NULL,
      key TEXT NOT NULL,
      peril_table_id TEXT DEFAULT '',
      PRIMARY KEY(table_id, assign_type, key)
    );

    -- Historique de voyages (par table de jeu)
    CREATE TABLE IF NOT EXISTS trip_history (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      table_id INTEGER NOT NULL REFERENCES game_tables(id) ON DELETE CASCADE,
      ship_name TEXT DEFAULT '',
      data_json TEXT NOT NULL,
      created_at TEXT DEFAULT (datetime('now'))
    );

    -- État par table (vaisseau actif, etc.)
    CREATE TABLE IF NOT EXISTS table_state (
      table_id INTEGER PRIMARY KEY REFERENCES game_tables(id) ON DELETE CASCADE,
      active_ship_id TEXT DEFAULT ''
    );

    -- Règles de visibilité (ce qui est caché aux joueurs d'une table)
    CREATE TABLE IF NOT EXISTS visibility_rules (
      table_id INTEGER NOT NULL REFERENCES game_tables(id) ON DELETE CASCADE,
      entity_type TEXT NOT NULL,
      entity_key TEXT NOT NULL,
      PRIMARY KEY(table_id, entity_type, entity_key)
    );
  `);

  console.log('✅ Base de données initialisée:', DB_PATH);
}

// ── Helpers: conversion frontend ↔ DB ──

// Reconstruit donnees[coord] depuis la table systems
function getQuadrantsMap(visibilityFilter) {
  const d = getDB();
  const rows = d.prepare('SELECT * FROM systems ORDER BY quadrant, id').all();
  const map = {};
  for (const r of rows) {
    if (visibilityFilter && visibilityFilter.has(`${r.quadrant}:${r.nom}`)) continue;
    if (!map[r.quadrant]) map[r.quadrant] = [];
    map[r.quadrant].push(systemRowToObj(r));
  }
  return map;
}

function systemRowToObj(r) {
  return {
    nom: r.nom,
    faction: r.faction || '',
    isFrontiere: !!r.is_frontiere,
    route: r.route || '',
    gouvernement: r.gouvernement || '',
    description: r.description || '',
    soleil: safeJSON(r.soleil_json, {}),
    corpsCelestes: safeJSON(r.corps_celestes_json, []),
    patrouilles: safeJSON(r.patrouilles_json, [])
  };
}

function systemObjToRow(quadrant, sys) {
  const soleil = sys.soleil || {};
  return {
    quadrant,
    nom: sys.nom || '',
    faction: sys.faction || '',
    is_frontiere: sys.isFrontiere ? 1 : 0,
    route: sys.route || '',
    gouvernement: sys.gouvernement || '',
    description: sys.description || '',
    soleil_json: JSON.stringify(soleil),
    corps_celestes_json: JSON.stringify(sys.corpsCelestes || []),
    patrouilles_json: JSON.stringify(sys.patrouilles || [])
  };
}

// Ship: DB row ↔ frontend object
function shipRowToObj(r) {
  return {
    id: r.id,
    nom: r.nom,
    modele: r.modele || '',
    _fromModel: r.from_model || '',
    position: r.position || '',
    positionSystem: r.position_system || '',
    positionAstre: r.position_astre || '',
    classe: r.classe || '',
    origine: r.origine || '',
    vitesseCroisiere: r.vitesse_croisiere || 0,
    vitesseHyperspatiale: r.vitesse_hyperspatiale || 0,
    autonomie: r.autonomie || 0,
    manoeuvrabilite: r.manoeuvrabilite || '',
    vitesseTactique: r.vitesse_tactique || '',
    blindage: r.blindage || 0,
    coque: r.coque || 0,
    senseurs: r.senseurs || '',
    equipage: r.equipage || '',
    passagers: r.passagers || '',
    soute: r.soute || 0,
    prix: r.prix || 0,
    image: r.image || '',
    armement: safeJSON(r.armement_json, []),
    systemesSecondaires: safeJSON(r.systemes_secondaires_json, [])
  };
}

function shipObjToRow(obj, tableId) {
  return {
    id: obj.id,
    table_id: tableId,
    nom: obj.nom || '',
    modele: obj.modele || '',
    from_model: obj._fromModel || '',
    position: obj.position || '',
    position_system: obj.positionSystem || '',
    position_astre: obj.positionAstre || '',
    classe: obj.classe || '',
    origine: obj.origine || '',
    vitesse_croisiere: obj.vitesseCroisiere || 0,
    vitesse_hyperspatiale: obj.vitesseHyperspatiale || 0,
    autonomie: obj.autonomie || 0,
    manoeuvrabilite: obj.manoeuvrabilite || '',
    vitesse_tactique: obj.vitesseTactique || '',
    blindage: obj.blindage || 0,
    coque: obj.coque || 0,
    senseurs: obj.senseurs || '',
    equipage: obj.equipage || '',
    passagers: obj.passagers || '',
    soute: obj.soute || 0,
    prix: obj.prix || 0,
    image: obj.image || '',
    armement_json: JSON.stringify(obj.armement || []),
    systemes_secondaires_json: JSON.stringify(obj.systemesSecondaires || [])
  };
}

// Ship model: same structure but without position/table fields
function shipModelRowToObj(r) {
  return {
    id: r.id,
    nom: r.nom,
    modele: r.nom,
    classe: r.classe || '',
    vitesseCroisiere: r.vitesse_croisiere || 0,
    vitesseHyperspatiale: r.vitesse_hyperspatiale || 0,
    autonomie: r.autonomie || 0,
    manoeuvrabilite: r.manoeuvrabilite || '',
    vitesseTactique: r.vitesse_tactique || '',
    blindage: r.blindage || 0,
    coque: r.coque || 0,
    senseurs: r.senseurs || '',
    equipage: r.equipage || '',
    passagers: r.passagers || '',
    soute: r.soute || 0,
    prix: r.prix || 0,
    origine: r.origine || '',
    image: r.image || '',
    armement: safeJSON(r.armement_json, []),
    systemesSecondaires: safeJSON(r.systemes_secondaires_json, [])
  };
}

function shipModelObjToRow(obj) {
  return {
    id: obj.id,
    nom: obj.nom || '',
    classe: obj.classe || '',
    vitesse_croisiere: obj.vitesseCroisiere || 0,
    vitesse_hyperspatiale: obj.vitesseHyperspatiale || 0,
    autonomie: obj.autonomie || 0,
    manoeuvrabilite: obj.manoeuvrabilite || '',
    vitesse_tactique: obj.vitesseTactique || '',
    blindage: obj.blindage || 0,
    coque: obj.coque || 0,
    senseurs: obj.senseurs || '',
    equipage: obj.equipage || '',
    passagers: obj.passagers || '',
    soute: obj.soute || 0,
    prix: obj.prix || 0,
    origine: obj.origine || '',
    image: obj.image || '',
    armement_json: JSON.stringify(obj.armement || []),
    systemes_secondaires_json: JSON.stringify(obj.systemesSecondaires || [])
  };
}

function safeJSON(str, fallback) {
  try { return JSON.parse(str || ''); } catch { return fallback; }
}

// ── Visibility helpers ──
function getHiddenEntities(tableId) {
  const d = getDB();
  const rows = d.prepare('SELECT entity_type, entity_key FROM visibility_rules WHERE table_id = ?').all(tableId);
  const hidden = { systems: new Set(), quadrants: new Set(), factions: new Set() };
  for (const r of rows) {
    if (hidden[r.entity_type]) hidden[r.entity_type].add(r.entity_key);
  }
  return hidden;
}

module.exports = {
  getDB, initDB,
  getQuadrantsMap, systemRowToObj, systemObjToRow,
  shipRowToObj, shipObjToRow,
  shipModelRowToObj, shipModelObjToRow,
  safeJSON, getHiddenEntities
};
