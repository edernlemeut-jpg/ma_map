# ── Metal Adventures — Variables d'environnement ────────────────────────────
# Copier ce fichier en .env et renseigner les valeurs avant le premier lancement.

# Port d'écoute du serveur HTTP
PORT=3000

# Clé secrète JWT — OBLIGATOIRE, minimum 32 caractères aléatoires
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-random-secret-here-replace-this-before-running

# Chemin vers la base de données SQLite
DB_PATH=./db/ma.db

# Environnement : development | production
NODE_ENV=development

